# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤, 아래에 본인 API 키를 붙여넣으세요.
# (API 키 발급: https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-여기에-본인-키-입력

# (선택) 팀 비밀번호. 설정하면 이 비밀번호를 아는 사람만 앱을 쓸 수 있습니다.
APP_PASSWORD=

# (선택) 워크스페이스가 지정되지 않은 조직용 API 키를 쓸 때만 필요합니다.
# console.anthropic.com → Settings → Workspaces 에서 wrkspc_ 로 시작하는 ID 를 복사하세요.
ANTHROPIC_WORKSPACE_ID=
